# Public URL of the site (used for canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store API (FastAPI). Leave empty to use the sample catalogue in src/lib/mock-data.ts
STORE_API_URL=
STORE_API_KEY=

# Shared secret the Store API sends to POST /api/revalidate after product changes
REVALIDATE_SECRET=

# Sessions: a random string of 32+ characters (required in production)
SESSION_SECRET=

# First staff login for /admin, used only to create the account when the staff table is empty.
# Afterwards change username/password in Admin → Account (stored hashed in the database).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SMS for login codes: "sparrow" (sparrowsms.com) or "aakash" (aakashsms.com).
# Without it, dev mode shows the code on screen instead of sending it.
SMS_PROVIDER=
SMS_TOKEN=
# Sparrow only: the sender identity approved on your Sparrow account
SMS_FROM=

# "Continue with Google": console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
# Authorised redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Continue with Facebook": developers.facebook.com > Create app > Facebook Login
# Valid OAuth redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# WhatsApp login codes (Meta WhatsApp Business Cloud API). developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of your approved "Authentication" message template
WHATSAPP_TEMPLATE=easypick_login
WHATSAPP_TEMPLATE_LANG=en

# Gemini image generation for product photos (scripts/gen-image.mjs). aistudio.google.com > Get API key
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=

# Email (gift links, gift cards): resend.com, free up to ~3,000 emails a month.
# Without these, emails are printed to the server log instead of being sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Easypick <gifts@easypick.com.np>
EMAIL_FROM=

# Email via Gmail (reaches any address today, ~500/day). Needs a Google App Password:
# myaccount.google.com/apppasswords (2-Step Verification must be on). Takes priority over Resend.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The store's WhatsApp number for the "Ask us" buttons, with country code (e.g. 9779800000000).
# Without it the buttons are hidden in production.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Database. Empty = `npm run dev` starts a local PostgreSQL (stored in .data/postgres) on 127.0.0.1:5433.
# For the live site: a hosted PostgreSQL connection string, e.g. Supabase (Mumbai region):
#   postgresql://postgres.<project>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Tables are created/updated on start only for a local database in development. A hosted database
# (and every production server) is migrated with `npm run db:migrate`, which takes a lock so two
# runs never clash. `npm run dev` against a hosted database prints a "Using the LIVE database" banner
# and never adds the sample catalogue to it.
DATABASE_URL=
# Leave empty. "true" forces migrations on start (not for the live site); "false" turns them off everywhere.
DB_AUTO_MIGRATE=
# On Vercel use Supabase's "Transaction pooler" string (IPv4, port 6543) as DATABASE_URL:
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase project, for Storage (product photos) later. The secret key is server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Payments. PAYMENTS_MODE=test (default) uses each wallet's sandbox; "live" uses production.
# eSewa and Fonepay have public test merchants, used automatically in test mode.
# Khalti needs a test key: sign up at https://test-admin.khalti.com (OTP 987654), copy the live_secret_key.
PAYMENTS_MODE=test
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=
# Optional: override eSewa's form and status-check addresses (normally picked from PAYMENTS_MODE).
ESEWA_FORM_URL=
ESEWA_STATUS_URL=
# On a production build, the eSewa sandbox only works when PAYMENTS_MODE=test is set on purpose
# (a trial deploy). Leave it empty and nobody can "pay" with the public test account; set
# PAYMENTS_MODE=live with ESEWA_PRODUCT_CODE and ESEWA_SECRET_KEY for real payments.

# ---------- Running the live site ----------
# A production server refuses to start without NEXT_PUBLIC_SITE_URL (https, the real domain),
# SESSION_SECRET (32+ chars) and DATABASE_URL, and logs an error for each of CRON_SECRET, SMS,
# email and Supabase that's missing. Vercel preview deployments may leave NEXT_PUBLIC_SITE_URL
# empty: they use their own *.vercel.app address.

# Protects /api/cron (pays late eSewa payments, expires unpaid orders, cleans old data).
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET=

# Where "new order" and "needs attention" emails go. Defaults to GMAIL_USER.
STAFF_ALERT_EMAIL=

# Database connections per server instance (default 5). Each Vercel instance opens its own,
# and Supabase's pooler has a limit: lower it if the pooler reports too many clients.
DB_POOL_MAX=

# 1 = fill an empty database with the sample catalogue in production too (off by default).
SEED_SAMPLE=

# Most login codes sent per day, across everyone (default 1000). Stops a bot running up the SMS bill.
CODE_DAILY_CAP=
